rules_version = '2';

// ============================================================
// Hanma Health — Firestore Security Rules
// ============================================================
// Data model: one document per authenticated user at
//   users/{userId}
// Document shape: { state: AppState, updatedAt: number }
//
// AppState contains ALL user data:
//   userProfile   — age, sex, height, weight, body metrics
//   weightPlanner — target weight, calorie budget, timeline
//   dailyLogs     — nutrition logs, hydration logs, workouts
//   progressHistory — weight history entries
//   streak        — gamification streak data
//   settings      — reminders, theme preferences
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Default deny ───────────────────────────────────────
    // Every path not explicitly matched is inaccessible.
    // This is belt-and-suspenders: Firestore denies by default,
    // but an explicit rule makes the intent unambiguous.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── User documents ────────────────────────────────────
    // Each user owns exactly one document. No cross-user
    // access is possible: a user can never read, write, or
    // delete another user's nutrition logs, weight history,
    // profile data, hydration data, or settings.
    match /users/{userId} {

      // Read: must be the authenticated owner
      allow read: if isOwner(userId);

      // Create / update: must be the owner AND the document
      // must pass structural and range validation so a
      // compromised client cannot inject malformed data.
      allow create, update: if isOwner(userId)
                            && isValidUserDocument();

      // Delete: only the owner can delete their own data
      allow delete: if isOwner(userId);
    }

    // ── Helper functions ───────────────────────────────────

    // Caller is signed in and the UID matches the document path.
    function isOwner(userId) {
      return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Top-level document must contain exactly 'state' and
    // 'updatedAt', with sane types and a timestamp that is not
    // forged into the far future (allows up to 5 min clock skew).
    function isValidUserDocument() {
      let d = request.resource.data;
      return d.keys().hasAll(['state', 'updatedAt'])
          && d.keys().hasOnly(['state', 'updatedAt'])
          && d.updatedAt is number
          && d.updatedAt <= request.time.toMillis() + 300000
          && d.state is map
          && hasRequiredStateFields(d.state);
    }

    // AppState must carry all six top-level sub-objects with
    // the correct types. Optional calculated fields (bmi, bf,
    // bmr, tdee …) are allowed on userProfile but not required
    // here — we validate only the fields the app always writes.
    function hasRequiredStateFields(s) {
      return s.keys().hasAll([
              'userProfile',
              'weightPlanner',
              'dailyLogs',
              'progressHistory',
              'streak',
              'settings'
            ])
          && s.userProfile    is map
          && s.weightPlanner  is map
          && s.dailyLogs      is map
          && s.progressHistory is list
          && s.streak         is map
          && s.settings       is map
          && isValidUserProfile(s.userProfile)
          && isValidWeightPlanner(s.weightPlanner)
          && isValidStreak(s.streak)
          && isValidSettings(s.settings);
    }

    // userProfile — validates the fields that the app always
    // writes and enforces physiologically sane ranges to prevent
    // extreme / nonsensical data from being stored.
    function isValidUserProfile(p) {
      return p.keys().hasAll(['age', 'sex', 'height', 'weight', 'activity'])
          // age: 10–120 years
          && p.age is number
          && p.age >= 10
          && p.age <= 120
          // sex: binary enum matching TypeScript type
          && p.sex in ['male', 'female']
          // height: 50–280 cm
          && p.height is number
          && p.height >= 50
          && p.height <= 280
          // weight: 10–500 kg
          && p.weight is number
          && p.weight >= 10
          && p.weight <= 500
          // activity multiplier stored as a string ("1.2"–"1.9")
          && p.activity is string
          && p.activity.size() > 0
          && p.activity.size() <= 10;
    }

    // weightPlanner — validates the calorie budget, target weight,
    // and timeline used across the Nutrition and Diet Planner pages.
    function isValidWeightPlanner(w) {
      return w.keys().hasAll(['targetWeight', 'timelineMonths', 'calorieBudget'])
          // targetWeight: 10–500 kg
          && w.targetWeight is number
          && w.targetWeight >= 10
          && w.targetWeight <= 500
          // timelineMonths: 1–24 months
          && w.timelineMonths is number
          && w.timelineMonths >= 1
          && w.timelineMonths <= 24
          // calorieBudget: 0–10 000 kcal/day
          // (0 is allowed for uninitialised state; the app floors at 1200/1500)
          && w.calorieBudget is number
          && w.calorieBudget >= 0
          && w.calorieBudget <= 10000;
    }

    // streak — counters must be non-negative numbers
    function isValidStreak(s) {
      return s.keys().hasAll(['currentStreak', 'loggedDaysCount', 'lastLogDate'])
          && s.currentStreak is number
          && s.currentStreak >= 0
          && s.loggedDaysCount is number
          && s.loggedDaysCount >= 0
          && s.lastLogDate is string;
    }

    // settings — skinTheme must be a known value; waterReminders
    // must be a map (deeper validation is handled app-side).
    function isValidSettings(s) {
      return s.keys().hasAll(['skinTheme', 'waterReminders'])
          && s.skinTheme in ['classic', 'demon']
          && s.waterReminders is map
          && isValidWaterReminders(s.waterReminders);
    }

    // waterReminders — prevent a rogue client from writing a
    // negative interval that could cause rapid notification loops.
    function isValidWaterReminders(r) {
      return r.keys().hasAll(['enabled', 'intervalMinutes', 'lastNotifiedAt'])
          && r.enabled is bool
          // interval: 15 minutes – 24 hours
          && r.intervalMinutes is number
          && r.intervalMinutes >= 15
          && r.intervalMinutes <= 1440
          && r.lastNotifiedAt is number
          && r.lastNotifiedAt >= 0;
    }
  }
}
