# Hanma Health — Firebase Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values from:
#   Firebase Console → Project Settings → Your apps → Web app
#
# .env.local is already listed in .gitignore (via *.local) so
# these values will never be committed to git.
#
# For Replit deployment: set each value as a Replit Secret
# (Tools → Secrets) so they are available to the Vite build.
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id_hash
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
